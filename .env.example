# =========================================================
# ENTERPRISE LMS CONFIGURATION & ENVIRONMENT VARIABLES
# Copy to .env and replace every CHANGE_ME value.
# The API refuses to start with missing, short, or placeholder secrets.
# =========================================================

NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
# DATABASE_URL is what the API runs with. It MUST be the unprivileged lms_app role (not a
# superuser, no BYPASSRLS) or tenant isolation is not enforced. See packages/database/sql/create_app_role.sql
# The API refuses to start in production if this role can bypass row-level security.
DATABASE_URL="postgresql://lms_app:CHANGE_ME@localhost:5432/lms_preview?schema=public"
# DIRECT_URL is a privileged role used only for migrations and the dev seed.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lms_preview?schema=public"

# Optional. Shares rate-limit counters between API instances (required if you run more than one).
# If unset, counters are in memory per process.
# REDIS_URL="redis://localhost:6379"

# Security
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME"
# Session lifetime (jsonwebtoken format, e.g. 8h, 30m)
JWT_EXPIRES_IN="8h"
# Field-level encryption key, 32 bytes as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY="CHANGE_ME"
BCRYPT_ROUNDS=12
# Number of reverse proxies in front of the API (0 = none). Set 1 when behind the Next.js proxy.
# Only do this if the API is not directly reachable, otherwise X-Forwarded-For can be spoofed.
TRUST_PROXY=0
# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS="http://localhost:3000"
# Tenant used for login when the request carries no tenant hint (slug, id or custom domain)
DEFAULT_TENANT_SLUG="harvard"
# Slug of the organisation whose super administrators are the platform operator: they approve or reject
# organisation registration requests, create and suspend organisations, and set every organisation's plan
# tier, seat quota and feature overrides (the platform admin page). Unset: none of that is available.
# Create that organisation and its first operator with:
#   npm run platform:bootstrap -w @enterprise-lms/api -- --email ops@example.com --first Ada --last Lovelace [--password '...']
# PLATFORM_OPERATOR_TENANT="operator"
# Institutions may ask for an organisation from the public site ("Register your organisation"); each
# request waits for the platform operator. "false" closes the form. Requests per IP per hour are capped.
# ORG_REGISTRATION_ENABLED="true"
# ORG_REQUEST_RATE_LIMIT_MAX=5
# Free trials for new organisations. 0 (the default): none, organisations start active (paid from day one).
# With N > 0, approved and operator-created organisations start as a trial ending N days later (the operator can
# choose per organisation, and start, extend, end or convert trials in the platform console). Administrators are
# e-mailed 7 days and 1 day before the end; then the organisation is read-only for ORG_TRIAL_GRACE_DAYS and
# afterwards suspended. TRIAL_JOB_INTERVAL_SECONDS: how often trials are checked (0 turns the job off).
# ORG_TRIAL_DAYS=0
# ORG_TRIAL_GRACE_DAYS=14
# TRIAL_JOB_INTERVAL_SECONDS=3600
# Offboarding: an administrator (or the operator) can schedule the organisation's deletion; it happens
# ORG_DELETION_GRACE_DAYS later (cancellable until then), after a final export kept 90 days for the operator. The
# deleted organisation's address stays reserved for ORG_DELETED_SLUG_HOLD_DAYS. OFFBOARDING_JOB_INTERVAL_SECONDS: how
# often exports are built, expired ones removed and due deletions carried out (0 turns the job off).
# ORG_DELETION_GRACE_DAYS=30
# ORG_DELETED_SLUG_HOLD_DAYS=90
# OFFBOARDING_JOB_INTERVAL_SECONDS=60
# Data-subject requests: DSAR_DUE_DAYS to answer one, DSAR_JOB_INTERVAL_SECONDS between warnings to administrators about
# due-soon and overdue ones (0: off). Data retention (off until an administrator enables a policy):
# RETENTION_JOB_INTERVAL_SECONDS between looks at the policies (each runs at most daily; 0: off), RETENTION_ROW_CAP rows
# per class per run.
# DSAR_DUE_DAYS=30
# DSAR_JOB_INTERVAL_SECONDS=21600
# Breach register: BREACH_JOB_INTERVAL_SECONDS between checks of the 72-hour notification clock (0: off).
# BREACH_JOB_INTERVAL_SECONDS=3600
# RETENTION_JOB_INTERVAL_SECONDS=3600
# RETENTION_ROW_CAP=5000
# CAPTCHA on the registration form: Cloudflare Turnstile (free, no tracking cookies). Add a widget for your
# host names at https://dash.cloudflare.com/?to=/:account/turnstile and set both keys (or neither). The web app
# reads the site key from the API at run time, so it needs no build setting. Unset: no CAPTCHA (fine for
# development; in production a warning is logged). If Cloudflare cannot be reached, requests are refused (503).
# Cloudflare's test keys, for trying it locally (any host name, no real challenge):
#   site key 1x00000000000000000000AA always passes, 2x00000000000000000000AB always blocks,
#            3x00000000000000000000FF always shows an interactive challenge;
#   secret   1x0000000000000000000000000000000AA always passes, 2x0000000000000000000000000000000AA always fails,
#            3x0000000000000000000000000000000AA answers "token already spent".
# TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# "Find my organisation" (bare address): e-mails a visitor the sign-in links of their organisations.
# Lookups per IP per hour; each e-mail address also gets at most 3 such e-mails an hour.
# FIND_ORG_RATE_LIMIT_MAX=10

# Per-IP requests per minute for the whole API (reads) and for POST/PUT/PATCH/DELETE. Counters are
# in memory per instance; move to a shared store (Redis) before running several API instances.
API_RATE_LIMIT_MAX=600
API_WRITE_RATE_LIMIT_MAX=120

# Logging: fatal|error|warn|info|debug|trace. Request bodies are NOT logged unless this is true.
LOG_LEVEL=info
LOG_REQUEST_BODIES=false

# Public URLs
APP_URL="http://localhost:3000"
# Where the Next.js app proxies /api/v1/* to
API_URL="http://localhost:4000"

# Custom domains (docs/custom-domains.md). An organisation's own domain works only once a DNS TXT record
# proves it controls it. CUSTOM_DOMAIN_TARGET is the host they point the domain at with a CNAME (shown to
# administrators and checked as a hint only). TLS_ASK_SECRET turns on GET /internal/tls/allowed, the
# on-demand TLS "ask" check of the reverse proxy (Caddy); without it that endpoint answers 404.
# CUSTOM_DOMAIN_TARGET="tenants.lms.example.com"
# TLS_ASK_SECRET="CHANGE_ME"   # node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# CUSTOM_DOMAIN_DNS_TIMEOUT_MS=5000
# Prometheus metrics: GET /metrics needs `Authorization: Bearer <METRICS_TOKEN>` (16+ characters); 404 while unset.
# METRICS_TOKEN="CHANGE_ME_16_CHARS_MIN"
# A live domain's TXT record is re-checked every CUSTOM_DOMAIN_RECHECK_INTERVAL_SECONDS (0: never). When it is
# missing the administrators are warned, and after CUSTOM_DOMAIN_RECHECK_GRACE_DAYS the domain is removed.
# CUSTOM_DOMAIN_RECHECK_INTERVAL_SECONDS=86400
# CUSTOM_DOMAIN_RECHECK_GRACE_DAYS=7

# Dev seed only (never used when NODE_ENV=production)
SEED_PASSWORD="CHANGE_ME"

# Uploaded files (assignment files, lesson documents and video). "local" keeps them in STORAGE_LOCAL_DIR on
# this server (one API server only; back the folder up). "s3" uses any S3-compatible service.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="storage"
# STORAGE_DRIVER="s3"
# S3_BUCKET="enterprise-lms-files"
# S3_REGION="us-east-1"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # omit for AWS
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_FORCE_PATH_STYLE="true"                                   # MinIO
UPLOAD_MAX_MB=100
# Virus scanning: a ClamAV daemon every upload is scanned with before it is stored. Its StreamMaxLength must be
# at least UPLOAD_MAX_MB. While it cannot be reached, uploads are refused. Unset: uploads are stored unscanned.
# CLAMAV_URL="tcp://localhost:3310"
# CLAMAV_TIMEOUT_MS=120000
# FILE_SCAN_SWEEP_INTERVAL_SECONDS=300                         # scans files stored before CLAMAV_URL was set

# Outgoing mail (password resets, notification e-mails). Without SMTP_URL, mail is printed in
# development and DROPPED in production.
# SMTP_URL="smtps://user:password@smtp.example.com:465"
MAIL_FROM="Enterprise LMS <no-reply@example.com>"
# Seconds between webhook retry sweeps (failed deliveries retry after 30s, 2m, 10m, 1h); 0 turns it off.
WEBHOOK_RETRY_INTERVAL_SECONDS=30
# Seconds between sends of queued notification e-mails; 0 turns the background sender off.
EMAIL_DISPATCH_INTERVAL_SECONDS=60
# Daily/weekly digest e-mails: how often the job checks who is due (0: off) and the most digests sent per run.
DIGEST_JOB_INTERVAL_SECONDS=900
DIGEST_MAX_PER_RUN=500

# Live classes: a LiveKit media server (https://livekit.io). All three are needed. Point LiveKit's
# webhook at POST /api/v1/integrations/livekit using the same key and secret.
# LIVEKIT_URL="wss://live.example.com"
# LIVEKIT_API_KEY="CHANGE_ME"
# LIVEKIT_API_SECRET="CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"

# Plagiarism provider callbacks (POST /api/v1/integrations/plagiarism/<tenant-slug>). Off when unset.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PLAGIARISM_WEBHOOK_SECRET="CHANGE_ME"
# Outbound: send text submissions to a similarity provider (or an adapter in front of Turnitin /
# Copyleaks). Signed with the secret above; the provider answers via the callback. Off when unset.
# PLAGIARISM_SUBMIT_URL="https://similarity.example.com/v1/checks"
# API_PUBLIC_URL="https://api.example.com"
# Or Copyleaks (https://copyleaks.com) instead of PLAGIARISM_SUBMIT_URL: the account e-mail and the API key
# from its API dashboard. Needs PLAGIARISM_WEBHOOK_SECRET and API_PUBLIC_URL too (Copyleaks calls back to
# /api/v1/integrations/copyleaks/...). COPYLEAKS_SANDBOX=true gives made-up results and uses no credits.
# COPYLEAKS_EMAIL="you@example.com"
# COPYLEAKS_API_KEY="CHANGE_ME"
# COPYLEAKS_SANDBOX="true"

# AI assistance: the learners' study tutor and draft course outlines for instructors.
# Each organisation's administrators can enter their own provider (Claude, Gemini or Grok) and key in
# Administration > Plan & Integrations; this is the platform-wide default used when they have not.
# Off when unset. Learner questions and course content are sent to the provider; names and e-mail addresses are not.
# The organisation's plan must also include the "aiAssistant" feature.
# AI_PROVIDER="ANTHROPIC"   # ANTHROPIC | GEMINI | XAI
# AI_API_KEY="CHANGE_ME"
# AI_MODEL="claude-opus-5-5"
# AI_REQUESTS_PER_HOUR=60

# LTI 1.3 Advantage Issuer
LTI_ISSUER_URL="https://lms.enterprise.com"
LTI_KEYSET_URL="https://lms.enterprise.com/api/v1/lti/jwks"

# SCORM packages run their own scripts, so they are served from an origin of their own pointing at this API
# (e.g. a second DNS name), never the web app's origin, and it must not share a cookie domain with it.
# Prefer a separate registrable domain (lms-content.example.net, not content.example.org): in production the
# session cookie is __Host-lms_token, which sibling subdomains cannot overwrite, but a separate site is safest.
# Unset: SCORM is off in production; development uses http://127.0.0.1:<PORT>.
# SCORM_CONTENT_ORIGIN="https://content.example.org"

# Billing with Razorpay (lib/billing.ts). Unset: subscribing answers 503. Webhook: https://<api>/api/v1/billing/webhook
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# BILLING_GRACE_DAYS=7
# SELLER_LEGAL_NAME="Your Company Pvt Ltd"
# SELLER_GSTIN=""
# SELLER_STATE_CODE=27
# SELLER_ADDRESS=""
