# =========================================================
# ENTERPRISE LMS CONFIGURATION & ENVIRONMENT VARIABLES
# Copy to .env and replace every CHANGE_ME value.
# The API refuses to start with missing, short, or placeholder secrets.
# =========================================================

NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
# DATABASE_URL is what the API runs with. It MUST be the unprivileged lms_app role (not a
# superuser, no BYPASSRLS) or tenant isolation is not enforced. See packages/database/sql/create_app_role.sql
# The API refuses to start in production if this role can bypass row-level security.
DATABASE_URL="postgresql://lms_app:CHANGE_ME@localhost:5432/enterprise_lms?schema=public"
# DIRECT_URL is a privileged role used only for migrations and the dev seed.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/enterprise_lms?schema=public"

# Optional. Shares rate-limit counters between API instances (required if you run more than one).
# If unset, counters are in memory per process.
# REDIS_URL="redis://localhost:6379"

# Security
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME"
# Session lifetime (jsonwebtoken format, e.g. 8h, 30m)
JWT_EXPIRES_IN="8h"
# Field-level encryption key, 32 bytes as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY="CHANGE_ME"
BCRYPT_ROUNDS=12
# Number of reverse proxies in front of the API (0 = none). Set 1 when behind the Next.js proxy.
# Only do this if the API is not directly reachable, otherwise X-Forwarded-For can be spoofed.
TRUST_PROXY=0
# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS="http://localhost:3000"
# Tenant used for login when the request carries no tenant hint (slug, id or custom domain)
DEFAULT_TENANT_SLUG="harvard"

# Per-IP requests per minute for the whole API (reads) and for POST/PUT/PATCH/DELETE. Counters are
# in memory per instance; move to a shared store (Redis) before running several API instances.
API_RATE_LIMIT_MAX=600
API_WRITE_RATE_LIMIT_MAX=120

# Logging: fatal|error|warn|info|debug|trace. Request bodies are NOT logged unless this is true.
LOG_LEVEL=info
LOG_REQUEST_BODIES=false

# Public URLs
APP_URL="http://localhost:3000"
# Where the Next.js app proxies /api/v1/* to
API_URL="http://localhost:4000"

# Dev seed only (never used when NODE_ENV=production)
SEED_PASSWORD="CHANGE_ME"

# S3 / Cloud Storage (Assets, SCORM packages, Transcripts)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET="enterprise-lms-storage"

# Outgoing mail (password resets, notification e-mails). Without SMTP_URL, mail is printed in
# development and DROPPED in production.
# SMTP_URL="smtps://user:password@smtp.example.com:465"
MAIL_FROM="Enterprise LMS <no-reply@example.com>"
# Seconds between webhook retry sweeps (failed deliveries retry after 30s, 2m, 10m, 1h); 0 turns it off.
WEBHOOK_RETRY_INTERVAL_SECONDS=30
# Seconds between sends of queued notification e-mails; 0 turns the background sender off.
EMAIL_DISPATCH_INTERVAL_SECONDS=60

# Live classes: a LiveKit media server (https://livekit.io). All three are needed. Point LiveKit's
# webhook at POST /api/v1/integrations/livekit using the same key and secret.
# LIVEKIT_URL="wss://live.example.com"
# LIVEKIT_API_KEY="CHANGE_ME"
# LIVEKIT_API_SECRET="CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"

# Plagiarism provider callbacks (POST /api/v1/integrations/plagiarism/<tenant-slug>). Off when unset.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PLAGIARISM_WEBHOOK_SECRET="CHANGE_ME"
# Outbound: send text submissions to a similarity provider (or an adapter in front of Turnitin /
# Copyleaks). Signed with the secret above; the provider answers via the callback. Off when unset.
# PLAGIARISM_SUBMIT_URL="https://similarity.example.com/v1/checks"
# API_PUBLIC_URL="https://api.example.com"

# AI assistance: the learners' study tutor and draft course outlines for instructors.
# Each organisation's administrators can enter their own provider (Claude, Gemini or Grok) and key in
# Administration > Plan & Integrations; this is the platform-wide default used when they have not.
# Off when unset. Learner questions and course content are sent to the provider; names and e-mail addresses are not.
# The organisation's plan must also include the "aiAssistant" feature.
# AI_PROVIDER="ANTHROPIC"   # ANTHROPIC | GEMINI | XAI
# AI_API_KEY="CHANGE_ME"
# AI_MODEL="claude-opus-5-5"
# AI_REQUESTS_PER_HOUR=60

# LTI 1.3 Advantage Issuer
LTI_ISSUER_URL="https://lms.enterprise.com"
LTI_KEYSET_URL="https://lms.enterprise.com/api/v1/lti/jwks"
