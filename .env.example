# =========================================================
# ENTERPRISE LMS CONFIGURATION & ENVIRONMENT VARIABLES
# Copy to .env and replace every CHANGE_ME value.
# The API refuses to start with missing, short, or placeholder secrets.
# =========================================================

NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
# DATABASE_URL is what the API runs with. It MUST be the unprivileged lms_app role (not a
# superuser, no BYPASSRLS) or tenant isolation is not enforced. See packages/database/sql/create_app_role.sql
# The API refuses to start in production if this role can bypass row-level security.
DATABASE_URL="postgresql://lms_app:CHANGE_ME@localhost:5432/enterprise_lms?schema=public"
# DIRECT_URL is a privileged role used only for migrations and the dev seed.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/enterprise_lms?schema=public"

# Redis Cache & Pub/Sub
REDIS_URL="redis://localhost:6379"

# Security
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME"
# Session lifetime (jsonwebtoken format, e.g. 8h, 30m)
JWT_EXPIRES_IN="8h"
# Field-level encryption key, 32 bytes as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY="CHANGE_ME"
BCRYPT_ROUNDS=12
# Number of reverse proxies in front of the API (0 = none). Set 1 when behind the Next.js proxy.
# Only do this if the API is not directly reachable, otherwise X-Forwarded-For can be spoofed.
TRUST_PROXY=0
# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS="http://localhost:3000"
# Tenant used for login when the request carries no tenant hint (slug, id or custom domain)
DEFAULT_TENANT_SLUG="harvard"

# Public URLs
APP_URL="http://localhost:3000"
# Where the Next.js app proxies /api/v1/* to
API_URL="http://localhost:4000"

# Dev seed only (never used when NODE_ENV=production)
SEED_PASSWORD="CHANGE_ME"

# S3 / Cloud Storage (Assets, SCORM packages, Transcripts)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET="enterprise-lms-storage"

# LTI 1.3 Advantage Issuer
LTI_ISSUER_URL="https://lms.enterprise.com"
LTI_KEYSET_URL="https://lms.enterprise.com/api/v1/lti/jwks"
