{
  "name": "enterprise-lms",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-Grade Multi-Tenant Educational Learning Management System (LMS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev --workspace=@enterprise-lms/api\" \"npm run dev --workspace=@enterprise-lms/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "lms",
    "edtech",
    "scorm",
    "lti-advantage",
    "xapi",
    "enterprise",
    "multi-tenant",
    "ferpa"
  ],
  "author": "Enterprise EdTech Engineering Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2"
  }
}
