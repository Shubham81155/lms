# =====================================================================================================================
# PRODUCTION ENVIRONMENT for docker-compose.prod.yml
#
#   cp .env.production.example .env && chmod 600 .env      # on the server, next to docker-compose.prod.yml
#
# [REQUIRED]  the stack refuses to start without it (compose or the API's own validation, apps/api/src/config.ts).
# [OPTIONAL]  leave it COMMENTED OUT when unused. An uncommented empty value (FOO=) reaches the API as an empty
#             string, which most settings reject at start-up.
#
# Never commit the filled-in file. Generate secrets on the server, e.g.
#   hex (URL-safe, for passwords inside URLs):  openssl rand -hex 32
#   base64url:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The product domain is not decided yet: every example.com / example.net below is a placeholder.
# DNS records, certificates and the first-deploy steps: docs/deployment/dns-and-tls.md
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------- addresses
# [REQUIRED] Parent domain of the platform. The platform itself answers on it, every organisation on
# <slug>.TENANT_BASE_DOMAIN. Caddy gets a wildcard certificate for it (as LMS_BASE_DOMAIN).
TENANT_BASE_DOMAIN=lms.example.com
# [OPTIONAL] Public URL of the web app; default https://TENANT_BASE_DOMAIN. Used in e-mail links.
# APP_URL=https://lms.example.com
# [OPTIONAL] Browser origins allowed to call the API cross-origin; default https://TENANT_BASE_DOMAIN. Browsers
# call /api/v1 on the page's own origin, so organisation subdomains and custom domains need no entry here.
# CORS_ORIGINS=https://lms.example.com
# [REQUIRED] Host of the SCORM content origin, WITHOUT https:// (the API gets SCORM_CONTENT_ORIGIN=https://<this>).
# Use a SEPARATE registrable domain from TENANT_BASE_DOMAIN (lms-content.example.net, not content.lms.example.com):
# SCORM packages run their own scripts there.
SCORM_CONTENT_HOST=lms-content.example.net
# [REQUIRED] The host customers CNAME their own domains to. Must resolve to this server. Under TENANT_BASE_DOMAIN it
# reuses the wildcard certificate. Pick a label no organisation will want: Caddy serves it as a redirect, so an
# organisation with that slug would be unreachable (see the open question in the deployment doc).
CUSTOM_DOMAIN_TARGET=tenants.lms.example.com
# [OPTIONAL] Public base URL of the API as outside services see it (plagiarism/Copyleaks callbacks). /api/* on the
# platform address is routed straight to the API, so the platform address works.
# API_PUBLIC_URL=https://lms.example.com
# [OPTIONAL] Proxies in front of the API. Default 1 (Caddy). Raise to 2 only if Caddy itself sits behind a load
# balancer that is listed in Caddy's trusted_proxies (deploy/Caddyfile).
# TRUST_PROXY=1

# ---------------------------------------------------------------------------------------------------- TLS (Caddy)
# [REQUIRED] Account e-mail for Let's Encrypt (expiry and problem notices).
ACME_EMAIL=ops@example.com
# [OPTIONAL] ACME directory. Use the staging one for a trial run (untrusted certificates, generous rate limits),
# then remove this line and delete the caddy-data volume's staging certificates (see the deployment doc).
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# [REQUIRED] Cloudflare API token for the DNS-01 challenge of the wildcard certificate. Only Caddy receives it.
# Scopes: Zone > Zone > Read and Zone > DNS > Edit, limited to the TENANT_BASE_DOMAIN zone.
CLOUDFLARE_API_TOKEN=CHANGE_ME
# [REQUIRED] Shared by Caddy and the API: authorises Caddy's on-demand TLS "ask" (GET /internal/tls/allowed).
# At least 16 characters, URL-safe (it travels in a query string): openssl rand -hex 24
TLS_ASK_SECRET=CHANGE_ME
# [OPTIONAL] Largest request body Caddy passes to the API; keep it a little above UPLOAD_MAX_MB. Default 110MB.
# EDGE_MAX_BODY=110MB

# ---------------------------------------------------------------------------------------------------- database
# [REQUIRED] Superuser / owner of the schema. Used only by the postgres container and the one-shot migrate service.
# Hex only: it is placed inside a connection URL.
POSTGRES_PASSWORD=CHANGE_ME
# [REQUIRED] Password of lms_app, the unprivileged role the API connects with (row-level security applies to it).
# Set once, before the FIRST start: the init script only runs on an empty volume. Hex only (URL).
LMS_APP_DB_PASSWORD=CHANGE_ME
# [OPTIONAL] Defaults: postgres / enterprise_lms. Changing them after the first start needs a manual migration.
# POSTGRES_USER=postgres
# POSTGRES_DB=enterprise_lms

# ---------------------------------------------------------------------------------------------------- secrets
# [REQUIRED] Session signing key, at least 32 characters (base64url of 48 random bytes).
JWT_SECRET=CHANGE_ME
# [REQUIRED] Field-level encryption key: exactly 64 hex characters (openssl rand -hex 32). Losing it makes encrypted
# fields unreadable: keep a copy outside the server, apart from the database backups.
PII_ENCRYPTION_KEY=CHANGE_ME
# [OPTIONAL] Session lifetime (jsonwebtoken format). Default 8h.
# JWT_EXPIRES_IN=8h
# [OPTIONAL] Password hashing cost, 4-15. Default 12.
# BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------------------------------- platform
# [REQUIRED for the platform console] Slug of the operator organisation, whose super administrators
# approve registrations, create/suspend organisations and set plans. Create it after the first deploy with
#   docker compose -f docker-compose.prod.yml exec -w /app api npm run platform:bootstrap -w @enterprise-lms/api -- \
#     --email ops@example.com --first Ada --last Lovelace
# The slug becomes reserved and its address is <slug>.TENANT_BASE_DOMAIN.
PLATFORM_OPERATOR_TENANT=operator
# [OPTIONAL] Organisation the bare platform address and logins without an organisation hint fall back to.
# Default "default-tenant".
# DEFAULT_TENANT_SLUG=default-tenant
# [OPTIONAL] Public "Register your organisation" form (each request waits for the operator). Default true.
# ORG_REGISTRATION_ENABLED=true
# ORG_REQUEST_RATE_LIMIT_MAX=5
# [OPTIONAL] Free trials: days for new organisations (0, the default: no trial, active from day one), read-only
# grace days after a trial ends before suspension, and how often trials are checked (0: off).
# ORG_TRIAL_DAYS=0
# ORG_TRIAL_GRACE_DAYS=14
# TRIAL_JOB_INTERVAL_SECONDS=3600
# [OPTIONAL] Offboarding: days between scheduling an organisation's deletion and carrying it out, days its address
# stays reserved afterwards, and how often export/deletion jobs run (0: off).
# ORG_DELETION_GRACE_DAYS=30
# ORG_DELETED_SLUG_HOLD_DAYS=90
# OFFBOARDING_JOB_INTERVAL_SECONDS=60
# [OPTIONAL] Data-subject requests: days an organisation has to answer one (default 30), how often administrators are
# warned about due-soon and overdue requests (seconds, 0: off), how often data-retention policies are looked at
# (each runs at most daily; 0: off), and the most rows of one class a retention run removes.
# DSAR_DUE_DAYS=30
# DSAR_JOB_INTERVAL_SECONDS=21600
# RETENTION_JOB_INTERVAL_SECONDS=3600
# RETENTION_ROW_CAP=5000

# ---------------------------------------------------------------------------------------------------- custom domains
# [OPTIONAL] DNS lookup timeout for verification (ms); TXT re-check interval (s, 0: never); days a missing TXT record
# is tolerated before the domain is removed.
# CUSTOM_DOMAIN_DNS_TIMEOUT_MS=5000
# CUSTOM_DOMAIN_RECHECK_INTERVAL_SECONDS=86400
# CUSTOM_DOMAIN_RECHECK_GRACE_DAYS=7

# ---------------------------------------------------------------------------------------------------- CAPTCHA
# [OPTIONAL, recommended] Cloudflare Turnstile on public forms (registration, find my organisation). Set both or
# neither. Add every host name the forms appear on to the widget (TENANT_BASE_DOMAIN; Turnstile allows subdomains
# of listed hosts). The web app reads the site key from the API at run time: no rebuild needed.
# TURNSTILE_SITE_KEY=CHANGE_ME
# TURNSTILE_SECRET_KEY=CHANGE_ME

# ---------------------------------------------------------------------------------------------------- mail
# [OPTIONAL, effectively required] Without SMTP_URL, mail (invitations, password resets, trial notices) is DROPPED.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Example LMS <no-reply@example.com>"
# EMAIL_DISPATCH_INTERVAL_SECONDS=60
# [OPTIONAL] Daily/weekly digest e-mails: seconds between checks for due digests (0 turns digests off; default 900)
# and the most digests sent per run across all organisations (default 500).
# DIGEST_JOB_INTERVAL_SECONDS=900
# DIGEST_MAX_PER_RUN=500
# WEBHOOK_RETRY_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------------------------------- files
# [OPTIONAL] "local" (default; the uploads volume, one API instance only; back it up) or "s3" (any S3-compatible
# service). With s3, S3_BUCKET is required.
# STORAGE_DRIVER=s3
# S3_BUCKET=example-lms-files
# S3_REGION=us-east-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_FORCE_PATH_STYLE=false
# [OPTIONAL] Largest upload in MB (default 100). Raise EDGE_MAX_BODY and ClamAV's StreamMaxLength with it.
# UPLOAD_MAX_MB=100

# ---------------------------------------------------------------------------------------------------- virus scanning
# [OPTIONAL, recommended] Start the clamav service and scan every upload. Both lines together. While ClamAV is
# unreachable (it needs a few minutes after a start), uploads are refused.
# COMPOSE_PROFILES=scan
# CLAMAV_URL=tcp://clamav:3310
# CLAMAV_TIMEOUT_MS=120000
# FILE_SCAN_SWEEP_INTERVAL_SECONDS=300

# [OPTIONAL] Prometheus metrics: GET /metrics on the API answers only to `Authorization: Bearer <METRICS_TOKEN>` (at
# least 16 characters: openssl rand -hex 24), and with it unset answers 404. Scrape it from inside the Docker network
# (api:4000); it is not meant to be routed through the public proxy. GET /ready also checks Redis when one is configured.
# METRICS_TOKEN=

# ---------------------------------------------------------------------------------------------------- live classes
# [OPTIONAL] LiveKit media server; all three or none. Point LiveKit's webhook at
# https://TENANT_BASE_DOMAIN/api/v1/integrations/livekit.
# LIVEKIT_URL=wss://live.example.com
# LIVEKIT_API_KEY=CHANGE_ME
# LIVEKIT_API_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS

# ---------------------------------------------------------------------------------------------------- plagiarism
# [OPTIONAL] Callback secret (>= 32 chars); then EITHER a generic provider URL OR Copyleaks. Both need API_PUBLIC_URL.
# PLAGIARISM_WEBHOOK_SECRET=CHANGE_ME
# PLAGIARISM_SUBMIT_URL=https://similarity.example.com/v1/checks
# PLAGIARISM_SUBMIT_INTERVAL_SECONDS=30
# COPYLEAKS_EMAIL=you@example.com
# COPYLEAKS_API_KEY=CHANGE_ME
# COPYLEAKS_SANDBOX=false

# ---------------------------------------------------------------------------------------------------- AI
# [OPTIONAL] Platform-wide default AI provider (organisations may bring their own key instead).
# AI_PROVIDER=ANTHROPIC          # ANTHROPIC | GEMINI | XAI
# AI_API_KEY=CHANGE_ME
# AI_MODEL=
# AI_TIMEOUT_MS=60000
# AI_REQUESTS_PER_HOUR=60

# ---------------------------------------------------------------------------------------------------- limits and logs
# [OPTIONAL] Defaults shown. Counters are shared through the bundled Redis.
# API_RATE_LIMIT_MAX=600
# API_WRITE_RATE_LIMIT_MAX=120
# LOGIN_RATE_LIMIT_MAX=10
# TOKEN_FLOW_RATE_LIMIT_MAX=10
# FIND_ORG_RATE_LIMIT_MAX=10
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# LOG_LEVEL=info
# LOG_REQUEST_BODIES=false

# ---------------------------------------------------------------------------------------------------- backups
# [OPTIONAL] Nightly database backups: COMPOSE_PROFILES=backup (docker compose --profile backup). Dumps go to the
# `backups` volume; docs/deployment/operations.md covers restores and the monthly restore drill. Without
# BACKUP_S3_BUCKET the dumps stay on this server, which is not a backup against losing the server: set the bucket.
# BACKUP_AT=02:30                     # UTC, daily
# BACKUP_KEEP_DAYS=14                 # local files only; use a bucket lifecycle rule for the copies there
# BACKUP_ENCRYPTION_PASSPHRASE=       # encrypts dumps (AES-256); store it OUTSIDE this server too: no passphrase, no restore
# BACKUP_S3_BUCKET=example-lms-backups
# BACKUP_S3_PREFIX=lms-backups
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # empty for AWS S3
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME   # a key that may only write to the backup bucket
# BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
# DRILL_REQUIRED_TABLES="Tenant User" # tables that must have rows in a restore drill

# ---------------------------------------------------------------------------------------------------- monitoring
# [OPTIONAL] Prometheus and Alertmanager: COMPOSE_PROFILES=monitoring (docker compose --profile monitoring). Needs
# METRICS_TOKEN above (the same value serves the API's /metrics and Prometheus's scrape). Set at least one receiver,
# or alerts are only visible in the Prometheus UI (127.0.0.1:PROMETHEUS_PORT, reach it with an SSH tunnel).
# Several profiles: COMPOSE_PROFILES=backup,monitoring
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...      # any Alertmanager-style webhook receiver
# ALERT_SMTP_SMARTHOST=smtp.example.com:587
# ALERT_EMAIL_FROM=lms-alerts@example.com
# ALERT_EMAIL_TO=ops@example.com
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_REQUIRE_TLS=true
# PROMETHEUS_PORT=9090
# PROMETHEUS_RETENTION=30d

# ---------------------------------------------------------------------------------------------------- images
# [OPTIONAL] Tag for the locally built images (default latest); set it per release to roll back easily.
# LMS_IMAGE_TAG=2026-10-20

# [OPTIONAL] Billing with Razorpay. Webhook: https://<api>/api/v1/billing/webhook (events: subscription.*).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# BILLING_GRACE_DAYS=7
# SELLER_LEGAL_NAME=
# SELLER_GSTIN=
# SELLER_STATE_CODE=27
# SELLER_ADDRESS=
